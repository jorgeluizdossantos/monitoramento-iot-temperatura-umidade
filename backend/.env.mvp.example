# Copie para .env.mvp. Credenciais DB_AIVEN_* e CA continuam somente no .env local.
NODE_ENV=development
DB_TARGET=aiven
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
MQTT_ENABLED=true
MQTT_URL=wss://broker.hivemq.com:8884/mqtt
