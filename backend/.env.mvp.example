MQTT_TOPIC_PREFIX=stma
MQTT_DEVICE_IDS=esp32-a8032a1e7214
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_FILE=
MQTT_PUBLISH_USERNAME=
MQTT_PUBLISH_PASSWORD=
DEMO_ENABLED=false
# Habilitar após provisionar DB_AIVEN_MAINTENANCE_USER/PASSWORD distintos da API.
JOBS_ENABLED=false
