# Arquivo próprio do backend STMA. O .env da raiz pertence ao setup legado.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Troque somente DB_TARGET após preencher os dois grupos.
DB_TARGET=local
DB_POOL_LIMIT=5
DB_CONNECT_TIMEOUT_MS=20000

DB_LOCAL_HOST=127.0.0.1
DB_LOCAL_PORT=13308
DB_LOCAL_NAME=stma_db
DB_LOCAL_USER=stma
DB_LOCAL_PASSWORD=

DB_AIVEN_HOST=
DB_AIVEN_PORT=
DB_AIVEN_NAME=stma_db
DB_AIVEN_USER=
DB_AIVEN_PASSWORD=
# Baixe a CA no painel Aiven; caminho relativo a backend/.
DB_AIVEN_CA_FILE=certs/aiven-ca.pem

# Somente para provisionamento do contêiner local, nunca usado pela API.
STMA_MYSQL_ROOT_PASSWORD=
