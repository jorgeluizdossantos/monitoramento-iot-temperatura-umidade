# Arquivo próprio do backend STMA. O .env da raiz pertence ao setup legado.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Troque somente DB_TARGET após preencher os dois grupos.
DB_TARGET=local
DB_POOL_LIMIT=5
DB_CONNECT_TIMEOUT_MS=20000

DB_LOCAL_HOST=127.0.0.1
DB_LOCAL_PORT=13308
DB_LOCAL_NAME=stma_db
DB_LOCAL_USER=stma
DB_LOCAL_PASSWORD=

DB_AIVEN_HOST=
DB_AIVEN_PORT=
DB_AIVEN_NAME=stma_db
DB_AIVEN_USER=
DB_AIVEN_PASSWORD=
# Baixe a CA no painel Aiven; caminho relativo a backend/.
DB_AIVEN_CA_FILE=certs/aiven-ca.pem
# Alternativa para hospedagem: certificado PEM multilinha na variável do provedor.
# Se preenchido, tem precedência sobre DB_AIVEN_CA_FILE. Nunca desabilite a verificação TLS.
DB_AIVEN_CA_PEM=

# Somente para provisionamento do contêiner local, nunca usado pela API.
STMA_MYSQL_ROOT_PASSWORD=
# Sessões: false somente para desenvolvimento em HTTP local.
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=8
PUBLIC_ORIGIN=http://localhost:3000
# Limites por janela de 15 minutos (processo único).
AUTH_IP_LIMIT=20
AUTH_EMAIL_LIMIT=5

# Provisionamento único via npm run auth:bootstrap. Remova a senha após concluir.
BOOTSTRAP_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# Fase 4: habilite somente após conferir broker, credenciais e destino do banco.
# Um client ID estável e exclusivo por instalação; sem fallback entre brokers.
MQTT_ENABLED=false
MQTT_URL=mqtt://127.0.0.1:18884
MQTT_CLIENT_ID=stma-backend-local
MQTT_TOPIC_PREFIX=engeasier
# Vazio aceita IDs válidos; em broker público liste somente as placas da bancada.
MQTT_DEVICE_IDS=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PUBLISH_USERNAME=
MQTT_PUBLISH_PASSWORD=
MQTT_CA_FILE=
MQTT_RECONNECT_MS=3000
MQTT_MAX_AGE_HOURS=168
MQTT_FUTURE_TOLERANCE_SECONDS=60

# Fase 6: habilita todas as rotinas no banco selecionado por DB_TARGET.
# Resumos: início + a cada hora (UTC); offline: a cada minuto.
# Expurgo >90 dias: 03:00; sessões inválidas >30 dias: 03:30 (America/Bahia).
JOBS_ENABLED=false

# Fase 7: pools separados, sem fallback para a conta principal da API.
# As contas precisam ser provisionadas antes de habilitar seus módulos.
DEMO_ENABLED=false
DB_LOCAL_MAINTENANCE_USER=
DB_LOCAL_MAINTENANCE_PASSWORD=
DB_LOCAL_DEMO_USER=
DB_LOCAL_DEMO_PASSWORD=
DB_AIVEN_MAINTENANCE_USER=
DB_AIVEN_MAINTENANCE_PASSWORD=
DB_AIVEN_DEMO_USER=
DB_AIVEN_DEMO_PASSWORD=
