# Copie para .env na raiz. Use senhas locais diferentes das credenciais de nuvem.
MYSQL_ROOT_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=13306
DB_NAME=monitoramento_iot
DB_USER=monitoramento
DB_PASSWORD=
# Broker compatível com MQTT 3.1.1, TLS e WSS; nunca colocar estas credenciais no frontend.
# URLs completas têm precedência sobre MQTT_HOST/portas; preencha ambas ou nenhuma.
MQTT_TLS_URL=
MQTT_WSS_URL=
# CA privada opcional, caminho relativo à raiz. Não desabilitar validação TLS.
MQTT_CA_FILE=
# Campos legados mantidos para compatibilidade com o setup inicial:
MQTT_HOST=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_PORT=8883
MQTT_WSS_PORT=8884
